ked\",\n  \"previous_attempt_evidence\": \"writer-run\",\n  \"task_sha256\": \"0921ed8b6dae553f8b1e9d6352fff2c2b31811a1671d1ccd5bad7bc1e7df64df\",\n  \"supervisor_corrected_files\": {\n    \"loop/admission_recovery.go\": \"44113f202eb74883f115b999ea5194ad5f8a25fe896013ade03808d262924b14\",\n    \".agents/skills/noodle/SKILL.md\": \"3fe3269f7a61cee54fd72e114005211cd3c8b08568b875a0e68c2c4a0c2da192\"\n  },\n  \"same_carrier_permissions\": true,\n  \"authorizes_landing\": false,\n  \"selected_at\": \"2026-09-17T07:02:16.714328+00:00\"\n}\nfrom pathlib import Path\nimport fcntl, hashlib, json, os, shutil, signal, subprocess, time, uuid\nr=Path(__file__).parent\nselection=json.loads((r/'execution-selection.json').read_text())\nroot=Path(selection['control_root']); runtime=root/'.noodle'; out=r/'writer-run-attempt2'; out.mkdir()\ntask=(r/'task-attempt2.txt').read_text()\nassert hashlib.sha256(task.encode()).hexdigest()==json.loads((r/'continuation-selection.json').read_text())['task_sha256']\nbefore=json.loads((runtime/'state.snapshot.json').read_text())\noriginal=before['state']['orders']['noodle-84']['stages'][0]\nassert original['status']=='review'\nsessions={x['session_id'] for x in original['attempts']}\nrequests=[{'action':'mode','value':'manual'}, {'action':'requeue','order_id':'noodle-84'}, {'action':'edit-item','order_id':'noodle-84','prompt':task}, {'action':'mode','value':'supervised'}]\nfor request in requests: request['id']='issue84-resume-'+uuid.uuid4().hex\n(out/'control-requests.json').write_text(json.dumps(requests,indent=2)+'\\n')\nwith (runtime/'control.lock').open('a') as lock:\n fcntl.flock(lock,fcntl.LOCK_EX)\n with (runtime/'control.ndjson').open('a') as f:\n  for request in requests: f.write(json.dumps(request)+'\\n')\n  f.flush();os.fsync(f.fileno())\nstart=time.monotonic();status='deadline';observed=None\nwith (out/'stdout.log').open('w') as stdout,(out/'stderr.log').open('w') as stderr:\n p=subprocess.Popen(['/Users/neon/.codex/experiments/noodle82-20260916/noodle','start'],cwd=root,env={**os.environ,'NOODLE_NO_BROWSER':'1','TMPDIR':'/private/tmp','GOMODCACHE':'/private/tmp/codex-go-mod','GOCACHE':'/private/tmp/codex-go-cache','GOPROXY':'file:///Users/neon/go/pkg/mod/cache/download','GOSUMDB':'off'},stdout=stdout,stderr=stderr,start_new_session=True)\n (out/'launch.json').write_text(json.dumps({'pid':p.pid,'argv':p.args,'cwd':str(root),'parent_emits_outcome':False},indent=2)+'\\n')\n while time.monotonic()-start<1800:\n  if p.poll() is not None:status='loop_exited';break\n  state=json.loads((runtime/'state.snapshot.json').read_text());stage=state['state']['orders']['noodle-84']['stages'][0]\n  new=any(x['session_id'] not in sessions for x in stage['attempts'])\n  if new and stage['status'] in ['review','completed','failed']:\n   status='worker_'+stage['status'];observed=state;break\n  time.sleep(.5)\n if p.poll() is None:\n  p.send_signal(signal.SIGTERM)\n  try:p.wait(timeout=15)\n  except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGTERM);p.wait(timeout=5)\n report={'status':status,'loop_exit':p.returncode,'elapsed_seconds':time.monotonic()-start,'snapshot_at_stop':observed,'authorizes_landing':False}\n (out/'observation.json').write_text(json.dumps(report,indent=2)+'\\n');shutil.copytree(runtime,out/'runtime',ignore=shutil.ignore_patterns('*.lock'))\n print(json.dumps({k:v for k,v in report.items() if k!='snapshot_at_stop'}))\nworktree /Users/neon/.codex/experiments/noodle78-delivery-20260916/control\nHEAD 656e9ec73689c523058750e8b0a2388a15bb84fa\nbranch refs/heads/main\n\nworktree /Users/neon/.codex/experiments/noodle78-delivery-20260916/control/.worktrees/issue84-control\nHEAD 656e9ec73689c523058750e8b0a2388a15bb84fa\nbranch refs/heads/issue84-control\n\nworktree /Users/neon/.codex/experiments/noodle78-delivery-20260916/control/.worktrees/issue84-control/.worktrees/noodle-84-0-execute\nHEAD 656e9ec73689c523058750e8b0a2388a15bb84fa\nbranch refs/heads/noodle-84-0-execute\n\n","exit_code":0,"status"