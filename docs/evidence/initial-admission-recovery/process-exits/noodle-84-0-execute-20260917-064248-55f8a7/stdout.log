tDir, binary, digest, revision string) AdmissionInspection {\n if len(digest) != 64 || !orderx.ValidOrderRevision(revision) {\n  return admissionRefusal(AdmissionInspection{Owner:admissionOwner},fmt.Errorf(\"invalid proposal digest or current_order_revision\"))\n }\n return recoverAdmission(projectDir,binary,digest,revision,nil)\n}\n\nfunc admissionRefusal(r AdmissionInspection, err error) AdmissionInspection {\n r.Status,r.Invalid = \"refused\",err.Error()\n r.Next = AdmissionNext{Argv:[]string{},Guidance:\"Stop: owner evidence or operation input is missing, active, changed or ambiguous. Preserve it and resolve the reported invalid evidence; no automatic retry is authorized.\"}\n return r\n}\n\nfunc recoverAdmission(projectDir,binary,digest,revision string, barrier func(string)) AdmissionInspection {\n r := AdmissionInspection{Owner:admissionOwner,Next:AdmissionNext{Argv:[]string{}}}\n dir := filepath.Join(projectDir,\".noodle\")\n lock,err := lockfile.TryLock(filepath.Join(dir,\"noodle.lock\"))\n if err != nil { return admissionRefusal(r,err) }\n defer lock.Close()\n snapshot,orders,err := readAdmissionEvidence(dir)\n if err != nil { return admissionRefusal(r,err) }\n r.Revision = snapshot.OrderRevision\n if revision != \"\" && revision != r.Revision { return admissionRefusal(r,fmt.Errorf(\"current_order_revision changed\")) }\n nextPath := filepath.Join(dir,\"orders-next.json\")\n data,err := readAdmissionFile(nextPath)\n missing := os.IsNotExist(err)\n if err != nil && !missing { return admissionRefusal(r,err) }\n // Read the exact receipt before inspecting a potentially later mailbox.\n var receipt *admissionReceipt\n if digest != \"\" {\n  receipt,err = readAdmissionReceipt(dir,digest,revision)\n  if err != nil { return admissionRefusal(r,err) }\n  if receipt != nil {\n   r.Subject = receipt.Subject\n   if receipt.Retired || missing {\n    if err := validateRetirementSubject(snapshot,orders,receipt.Proposal); err != nil { return admissionRefusal(r,err) }\n    