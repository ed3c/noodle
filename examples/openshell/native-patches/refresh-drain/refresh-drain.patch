+// SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Original gateway lifetime for provider refresh operations.
+
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+use tokio::sync::{OwnedRwLockReadGuard, RwLock};
+use tonic::Status;
+
+#[derive(Debug, Default)]
+pub(crate) struct RefreshLifecycle {
+    admission_closed: AtomicBool,
+    lifetimes: Arc<RwLock<()>>,
+}
+
+impl RefreshLifecycle {
+    pub(crate) fn admit(&self) -> Result<OwnedRwLockReadGuard<()>, Status> {
+        // As with supervisor sessions, tracking precedes the admission check.
+        // Shutdown either waits for this operation or prevents its admission.
+        let lifetime = Arc::clone(&self.lifetimes)
+            .try_read_owned()
+            .map_err(|_| Status::unavailable("gateway refresh admission closed"))?;
+        if self.admission_closed.load(Ordering::Acquire) {
+            return Err(Status::unavailable("gateway refresh admission closed"));
+        }
+        Ok(lifetime)
+    }
+
+    pub(crate) fn close_admission(&self) {
+        self.admission_closed.store(true, Ordering::Release);
+    }
+
+    pub(crate) async fn drain(&self) {
+        self.close_admission();
+        // No timeout: aborting a mint after issuer rotation can discard the
+        // only replacement grant before credential storage commits it.
+        let _closed = self.lifetimes.write().await;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn refresh_shutdown_waits_for_admitted_operations_and_stays_closed() {
+        let lifecycle = RefreshLifecycle::default();
+        let admitted = lifecycle.admit().unwrap();
+        lifecycle.close_admission();
+        assert_eq!(
+            lifecycle.admit().unwrap_err().code(),
+            tonic::Code::Unavailable
+        );
+        let drain = lifecycle.drain();
+        tokio::pin!(drain);
+        assert!(
+            std::future::poll_fn(|cx| {
+                use std::future::Future;
+                std::task::Poll::Ready(drain.as_mut().poll(cx).is_pending())
+            })
+            .await
+        );
+        drop(admitted);
+        drain.await;
+        assert!(lifecycle.admit().is_err());
+        // Another gateway's lifetime is independent of this closed owner.
+        assert!(RefreshLifecycle::default().admit().is_ok());
+    }
+}
