      "gists_url": "https://api.github.com/users/ed3c/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/ed3c/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/ed3c/subscriptions",
      "organizations_url": "https://api.github.com/users/ed3c/orgs",
      "repos_url": "https://api.github.com/users/ed3c/repos",
